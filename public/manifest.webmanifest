{
  "name": "Unread — catch up on group chats",
  "short_name": "Unread",
  "description": "Turn the unread into a clear next move.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f0e6",
  "theme_color": "#121210",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["text/plain", ".txt", "application/zip", ".zip", "application/json", ".json", "image/*", "application/pdf", ".pdf"]
        }
      ]
    }
  }
}
